{
  "schema": "onedge.v8.campaign/1",
  "campaign_id": "sim-robot-demo",
  "config_version": 1,
  "title": "Software rehearsal of the robot procedure (simulated monitor and robot)",
  "kind": "software_test",
  "status": "proposed",
  "purpose": "Rehearse the operator workflow of robot trials (confirmation, re-arm, motion check, injection, controller report, standstill criterion) against the simulator. Not robot data.",
  "procedure": "robot",
  "factors": {
    "workload": [{"level": "ECC", "purpose": "workload A"}, {"level": "ZKP", "purpose": "workload B"}],
    "alpha": [{"level": 0.3, "purpose": "intermediate"}, {"level": 0.5, "purpose": "fast"}],
    "failure_ms": [{"level": 0, "purpose": "control"}, {"level": 250, "purpose": "brief"}, {"level": 3000, "purpose": "sustained"}]
  },
  "design": {"type": "explicit", "conditions": [
    {"workload": "ECC", "alpha": 0.3, "failure_ms": 0, "purpose": "no injection"},
    {"workload": "ECC", "alpha": 0.5, "failure_ms": 3000, "purpose": "sustained failure"},
    {"workload": "ZKP", "alpha": 0.3, "failure_ms": 250, "purpose": "brief failure"}]},
  "repetitions": 1,
  "ordering": {"method": "explicit_sequence", "sequence": ["ECC-a0.30-f0", "ECC-a0.50-f3000", "ZKP-a0.30-f250"]},
  "trial": {"baseline_ms": 1000, "injection_jitter_ms": 0, "post_recover_ms": 2000, "inter_trial_ms": 500,
            "motion": {"approach_s": 5.0, "resume_program": "dashboard_play", "program_wait_s": 30.0}},
  "progression": {"mode": "operator_confirm_each_trial", "pause_on_operator_disconnect": true}
}
